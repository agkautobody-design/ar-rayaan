{
  "name": "ar-rayaan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ar-Rayaan community backend: accounts, family links, friends, invites (forums, games, meet-ups follow).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test --test-concurrency=1 --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.12.0",
    "pg": "^8.16.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
