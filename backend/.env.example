# Copy to .env for local work. NEVER commit real values.
# Names and meanings: README.md, "Configuration".

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Leave empty for a throwaway in-memory database (development only).
DATABASE_URL=

# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not change it once real accounts exist (it keys the e-mail and invite hashes).
PEPPER=

# firebase | email_code | both
AUTH_MODE=email_code
FIREBASE_PROJECT_ID=

# console (development only) | resend
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=

# Comma-separated exact origins of the web app, e.g. https://ar-rayaan.onrender.com
CORS_ORIGINS=http://localhost:8099
PUBLIC_APP_URL=http://localhost:8099
SESSION_TTL_DAYS=30
