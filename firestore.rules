rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    // ── Majlis ─────────────────────────────────────────────────────────
    // The Adab Engine, made literal: public read, signed-in write, field
    // validation, size caps, no impersonation beyond display names.
    // Rooms and seed threads are created by the founder (console/admin),
    // never by app clients.
    match /majlis_rooms/{room} {
      allow read: if true;
      allow write: if false;
    }
    match /majlis_rooms/{room}/threads/{thread} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['title', 'authorName', 'uid', 'createdAt', 'lastActivity', 'replyCount'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 140
        && validName(request.resource.data.authorName)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastActivity is timestamp
        && request.resource.data.replyCount == 1
        && request.resource.data.uid == request.auth.uid;
      // A reply bumps the counter by exactly one and touches the activity
      // time; nothing else on the thread can change.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['replyCount', 'lastActivity'])
        && request.resource.data.replyCount == resource.data.replyCount + 1
        && request.resource.data.lastActivity is timestamp;
      allow delete: if false;
    }
    match /majlis_rooms/{room}/threads/{thread}/posts/{post} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['body', 'authorName', 'uid', 'createdAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && validName(request.resource.data.authorName)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Family Wing ────────────────────────────────────────────────────
    // A parent's family document and everything under it belong to that
    // parent's account alone.
    match /families/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Per-user sync ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Online game rooms (Ludo, Shatranj) ─────────────────────────────
    // Anyone signed in can read a room by its code. The host creates it;
    // one guest may join a waiting room; after that only the two players
    // can write, and never change who the players are.
    match /game_rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host.uid == request.auth.uid
        && validName(request.resource.data.host.name)
        && request.resource.data.status == 'waiting'
        && request.resource.data.game is string;
      allow update: if signedIn() && (
        // Join: the waiting room gets its guest.
        (resource.data.status == 'waiting'
          && request.resource.data.guest.uid == request.auth.uid
          && validName(request.resource.data.guest.name)
          && request.resource.data.host == resource.data.host)
        ||
        // Play: only the two players, players fixed.
        ((request.auth.uid == resource.data.host.uid
            || (resource.data.guest != null
                && request.auth.uid == resource.data.guest.uid))
          && request.resource.data.host == resource.data.host
          && request.resource.data.guest == resource.data.guest)
      );
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
