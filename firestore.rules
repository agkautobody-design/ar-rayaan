rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    // ── Majlis ─────────────────────────────────────────────────────────
    // Posts are NOT reviewed before they appear. What the rules do enforce:
    // sign-in, field validation and size caps, server timestamps (so nobody
    // can pin a thread with a future time), a 20-second gap between writes
    // per person, reserved display names, a counter that can only move with
    // a real reply, and reports that only moderators can read.
    // Rooms and seed threads are created by the founder (console/admin),
    // never by app clients.

    // Names nobody may take: the app, its assistants, staff roles and
    // scholarly titles. Whole-word match on letters only; the app also
    // folds look-alike characters before it sends the name.
    function reservedName(n) {
      let s = n.lower();
      return s.matches('.*ar[^a-z]*rayaan.*')
        || s.matches('(.*[^a-z])?(hadi|sakina|noor|wasia|admin|moderator|mod|staff|team|official|support|founder|shaykh|sheikh|sheik|shaikh|imam|mufti|scholar|ustadh|ustaz|allama|hafiz)([^a-z].*)?');
    }

    function validAuthor(n) {
      return validName(n) && n.size() >= 2 && !reservedName(n);
    }

    // The per-person write clock. Every thread or post write in the same
    // batch must also move it, and it can only move once per 20 seconds.
    match /majlis_rate/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time
        && request.time > resource.data.lastPostAt + duration.value(20, 's');
      allow delete: if false;
    }

    function rateMoved() {
      return getAfter(/databases/$(database)/documents/majlis_rate/$(request.auth.uid)).data.lastPostAt == request.time;
    }

    match /majlis_rooms/{room} {
      allow read: if true;
      allow write: if false;
    }
    match /majlis_rooms/{room}/threads/{thread} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['title', 'authorName', 'uid', 'createdAt', 'lastActivity', 'replyCount', 'lastPostId'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 140
        && validAuthor(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time
        && request.resource.data.replyCount == 1
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastPostId is string
        && existsAfter(/databases/$(database)/documents/majlis_rooms/$(room)/threads/$(thread)/posts/$(request.resource.data.lastPostId))
        && rateMoved();
      // A reply bumps the counter by exactly one, stamps the activity time
      // with the server clock, and must arrive together with the post it
      // counts.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['replyCount', 'lastActivity', 'lastPostId'])
        && request.resource.data.replyCount == resource.data.replyCount + 1
        && request.resource.data.lastActivity == request.time
        && request.resource.data.lastPostId is string
        && existsAfter(/databases/$(database)/documents/majlis_rooms/$(room)/threads/$(thread)/posts/$(request.resource.data.lastPostId))
        && rateMoved();
      allow delete: if false;
    }
    match /majlis_rooms/{room}/threads/{thread}/posts/{post} {
      allow read: if true;
      // A post is only valid together with the thread write that counts it
      // (same batch), so posts cannot be dropped under a thread that does
      // not exist and the counter cannot move without a post.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['body', 'authorName', 'uid', 'createdAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && validAuthor(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/majlis_rooms/$(room)/threads/$(thread)).data.lastPostId == post
        && rateMoved();
      allow update, delete: if false;
    }

    // Reports: anyone signed in can file one (once per target); nobody can
    // read them from the app. Moderators use the console or admin tools.
    match /majlis_reports/{id} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['threadId', 'postId', 'target', 'reason', 'note', 'reporterUid', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.threadId is string
        && request.resource.data.target is string
        && id == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.reason in
             ['harassment', 'hate', 'unsafe', 'misinformation', 'spam', 'other']
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 300))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── Family Wing ────────────────────────────────────────────────────
    // A parent's family document and everything under it belong to that
    // parent's account alone.
    match /families/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Per-user sync ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Online game rooms (Ludo, Shatranj) ─────────────────────────────
    // Anyone signed in can read a room by its code. The host creates it;
    // one guest may join a waiting room; after that only the two players
    // can write, and never change who the players are.
    match /game_rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host.uid == request.auth.uid
        && validName(request.resource.data.host.name)
        && request.resource.data.status == 'waiting'
        && request.resource.data.game is string;
      allow update: if signedIn() && (
        // Join: the waiting room gets its guest.
        (resource.data.status == 'waiting'
          && request.resource.data.guest.uid == request.auth.uid
          && validName(request.resource.data.guest.name)
          && request.resource.data.host == resource.data.host)
        ||
        // Play: only the two players, players fixed.
        ((request.auth.uid == resource.data.host.uid
            || (resource.data.guest != null
                && request.auth.uid == resource.data.guest.uid))
          && request.resource.data.host == resource.data.host
          && request.resource.data.guest == resource.data.guest)
      );
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
