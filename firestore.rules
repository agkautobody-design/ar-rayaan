rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    // ── Majlis ─────────────────────────────────────────────────────────
    // Posts are NOT reviewed before they appear. What the rules do enforce:
    // sign-in, field validation and size caps, server timestamps (so nobody
    // can pin a thread with a future time), a 20-second gap between writes
    // per person, reserved display names, a counter that can only move with
    // a real reply, and reports that only moderators can read.
    // Rooms and seed threads are created by the founder (console/admin),
    // never by app clients.

    // Names nobody may take: the app, its assistants, staff roles and
    // scholarly titles. Whole-word match on letters only, after the same
    // digit and symbol look-alikes the app folds (0 o, 1 i, 3 e, 4 a, 5 s,
    // 7 t, @ a, $ s), so "h4di" and "Sakin4" are caught here too and not
    // only by the app. Accented and non-Latin look-alikes ("Hadi" with a
    // Cyrillic a) never get this far: see authorCharsOk.
    function foldedName(n) {
      return n.lower()
        .replace('0', 'o').replace('1', 'i').replace('3', 'e')
        .replace('4', 'a').replace('5', 's').replace('7', 't')
        .replace('@', 'a').replace('$', 's');
    }

    function reservedName(n) {
      let s = foldedName(n);
      return s.matches('.*ar[^a-z]*ray[ya]an.*')
        || s.matches('.*rayaan[^a-z]*app.*')
        || s.matches('(.*[^a-z])?(hadi|sakina|noor|wasia|admin|administrator|moderator|mod|staff|team|official|support|founder|shaykh|sheikh|sheik|shaikh|imam|mufti|scholar|ustadh|ustaz|allama|hafiz)([^a-z].*)?');
    }

    // Display names are plain ASCII letters and digits, space and . _ ' -,
    // or Arabic-script letters and marks (U+0621 to U+06D3, which covers Arabic
    // and Urdu).
    // Nothing else: Cyrillic, Greek and accented look-alikes, zero-width
    // characters and emoji can not be used to dodge the reserved-name check
    // above, which can only fold ASCII. (The trailing - is a literal.)
    function authorCharsOk(n) {
      return n.matches("[A-Za-z0-9 ._'ء-ۓ-]+");
    }

    function validAuthor(n) {
      return n is string && n.size() >= 2 && n.size() <= 30
        && authorCharsOk(n) && !reservedName(n);
    }

    // The only forum room that exists. Clients can not create rooms, so a
    // thread under any other id would be an orphan nobody can browse.
    function knownRoom(room) {
      return room == 'courtyard';
    }

    // The per-person write clock. Every thread or post write in the same
    // batch must also move it, and it can only move once per 20 seconds.
    match /majlis_rate/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time
        && request.time > resource.data.lastPostAt + duration.value(20, 's');
      allow delete: if false;
    }

    function rateMoved() {
      return getAfter(/databases/$(database)/documents/majlis_rate/$(request.auth.uid)).data.lastPostAt == request.time;
    }

    match /majlis_rooms/{room} {
      allow read: if true;
      allow write: if false;
    }
    match /majlis_rooms/{room}/threads/{thread} {
      // One thread by id, or a bounded list: an unbounded read is unbounded
      // cost (the app asks for at most 50).
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create: if signedIn()
        && knownRoom(room)
        && request.resource.data.keys().hasOnly(
             ['title', 'authorName', 'uid', 'createdAt', 'lastActivity', 'replyCount', 'lastPostId'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 140
        && validAuthor(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time
        && request.resource.data.replyCount == 1
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastPostId is string
        && existsAfter(/databases/$(database)/documents/majlis_rooms/$(room)/threads/$(thread)/posts/$(request.resource.data.lastPostId))
        && rateMoved();
      // A reply bumps the counter by exactly one, stamps the activity time
      // with the server clock, and must arrive together with the post it
      // counts.
      allow update: if signedIn()
        && knownRoom(room)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['replyCount', 'lastActivity', 'lastPostId'])
        && request.resource.data.replyCount == resource.data.replyCount + 1
        && request.resource.data.lastActivity == request.time
        && request.resource.data.lastPostId is string
        && existsAfter(/databases/$(database)/documents/majlis_rooms/$(room)/threads/$(thread)/posts/$(request.resource.data.lastPostId))
        && rateMoved();
      allow delete: if false;
    }
    match /majlis_rooms/{room}/threads/{thread}/posts/{post} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      // A post is only valid together with the thread write that counts it
      // (same batch), so posts cannot be dropped under a thread that does
      // not exist and the counter cannot move without a post.
      allow create: if signedIn()
        && knownRoom(room)
        && request.resource.data.keys().hasOnly(['body', 'authorName', 'uid', 'createdAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && validAuthor(request.resource.data.authorName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/majlis_rooms/$(room)/threads/$(thread)).data.lastPostId == post
        && rateMoved();
      allow update, delete: if false;
    }

    // Reports: anyone signed in can file one (once per target); nobody can
    // read them from the app. Moderators use the console or admin tools.
    match /majlis_reports/{id} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['threadId', 'postId', 'target', 'reason', 'note', 'reporterUid', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.threadId is string
        && request.resource.data.target is string
        && id == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.reason in
             ['harassment', 'hate', 'unsafe', 'misinformation', 'spam', 'other']
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 300))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── Family Wing ────────────────────────────────────────────────────
    // A parent's family document and everything under it belong to that
    // parent's account alone.
    match /families/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Per-user sync ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── Online game rooms (Ludo, Shatranj) ─────────────────────────────
    // A room is found by its six-character code, so a room can be read by
    // anyone signed in who knows the code, but rooms can NOT be listed
    // (nobody can enumerate other people's tables or ids).
    //
    // PRIVACY: a room holds no name. The players are only the anonymous
    // Firebase sign-in ids ({uid}); the app shows them as "Player 1" and
    // "Player 2". A room expires: it can not be read or written after its
    // `expireAt` (at most 12 hours after creation), and either player can
    // delete it (the app deletes it on leave). A child profile reaches this
    // only after a guardian switched it on, which the app enforces
    // (lib/features/games/data/online_access.dart); the rules can not know
    // who is holding the phone.
    //
    //  * create: the host, with exactly the fields the app writes, status
    //    "waiting", no guest, an empty move log and server timestamps. The
    //    code itself must be six characters from the app's alphabet.
    //  * join: only while "waiting" with no guest, by someone who is not
    //    the host, and the write may change nothing but guest, status
    //    (-> "playing") and lastTs. A joiner can not touch moves, turn or
    //    result.
    //  * play: only the host or the guest, only while the room is
    //    "waiting" or "playing", never the players, and only these fields:
    //    moves (at most ONE new numbered move per write, never changing or
    //    removing an earlier one), turn (to one of the two players),
    //    status (playing -> done or left; waiting -> left) and result.
    //    A "done" or "left" room is closed for good.
    //  * delete: either player, at any time (leaving a table deletes it).
    //    Rooms also carry an `expireAt` timestamp; a Firestore TTL policy
    //    on it removes anything left over (docs/OWNER_ACTIONS).
    //
    // Honest limit: this is not an anti-cheat. A player can still write a
    // move that is not legal; making the server the referee needs Cloud
    // Functions. The rules only stop outsiders and joiners from rewriting
    // the game.
    function roomHostUid() { return resource.data.host.uid; }

    function roomLive() { return resource.data.expireAt > request.time; }

    function roomIsPlayer() {
      return request.auth.uid == resource.data.host.uid
        || (resource.data.guest != null
            && request.auth.uid == resource.data.guest.uid);
    }

    function roomStatusMoveOk() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'playing'
            && request.resource.data.status in ['done', 'left'])
        || (resource.data.status == 'waiting'
            && request.resource.data.status == 'left');
    }

    function roomMovesOk() {
      return request.resource.data.moves == resource.data.moves
        || (resource.data.status == 'playing'
            && request.resource.data.moves.size() <= 1500
            && request.resource.data.moves.diff(resource.data.moves).changedKeys().size() == 0
            && request.resource.data.moves.diff(resource.data.moves).removedKeys().size() == 0
            && request.resource.data.moves.diff(resource.data.moves).addedKeys().size() == 1);
    }

    match /game_rooms/{code} {
      // `resource == null` lets the app ask whether a code is free.
      allow get: if signedIn() && (resource == null || roomLive());
      allow list: if false;

      allow create: if signedIn()
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(
             ['game', 'status', 'host', 'guest', 'turn', 'moves',
              'createdAt', 'lastTs', 'expireAt'])
        && request.resource.data.keys().hasAll(
             ['game', 'status', 'host', 'guest', 'turn', 'moves',
              'createdAt', 'lastTs', 'expireAt'])
        && request.resource.data.game in ['ludo', 'shatranj']
        && request.resource.data.status == 'waiting'
        && request.resource.data.host.keys().hasOnly(['uid'])
        && request.resource.data.host.uid == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.turn == request.auth.uid
        && request.resource.data.moves is map
        && request.resource.data.moves.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastTs == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(12, 'h');

      allow update: if signedIn() && roomLive() && (
        // Join: the waiting room gets its guest, and nothing else changes.
        (resource.data.status == 'waiting'
          && resource.data.guest == null
          && request.auth.uid != roomHostUid()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['guest', 'status', 'lastTs'])
          && request.resource.data.status == 'playing'
          && request.resource.data.guest.keys().hasOnly(['uid'])
          && request.resource.data.guest.uid == request.auth.uid
          && request.resource.data.lastTs == request.time)
        ||
        // Play: the two players, players fixed, a short list of fields.
        (roomIsPlayer()
          && resource.data.status in ['waiting', 'playing']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['moves', 'turn', 'status', 'result', 'lastTs'])
          && roomStatusMoveOk()
          && roomMovesOk()
          && (!('turn' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.turn == resource.data.host.uid
              || (resource.data.guest != null
                  && request.resource.data.turn == resource.data.guest.uid))
          && (!('result' in request.resource.data)
              || (request.resource.data.result is string
                  && request.resource.data.result.size() <= 40))
          && request.resource.data.lastTs == request.time)
      );

      // Leaving a table deletes it. Either player may, whatever the status.
      allow delete: if signedIn() && roomIsPlayer();
    }

    // ── Hadi reports ───────────────────────────────────────────────────
    // "Report this answer" on a Hadi reply. Create-only; nobody can read
    // them from the app. No user id is stored: the document holds the
    // reason, an excerpt of the answer, the passages it showed, and the
    // question only when the person chose to include it.
    match /hadi_reports/{id} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['reason', 'answer', 'question', 'sources', 'live', 'createdAt'])
        && request.resource.data.reason in
             ['wrong_quote', 'wrong_ruling', 'unsafe', 'unhelpful', 'other']
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 1200
        && (!('question' in request.resource.data)
            || (request.resource.data.question is string
                && request.resource.data.question.size() <= 500))
        && request.resource.data.sources is list
        && request.resource.data.sources.size() <= 5
        && request.resource.data.live is bool
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
