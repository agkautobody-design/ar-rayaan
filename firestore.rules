rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The Adab Engine, made literal: public read, authenticated write,
    // field validation, size caps, no impersonation beyond display names.
    match /majlis_rooms/{room} {
      allow read: if true;
      allow write: if false; // rooms are created once by the app, then fixed
    }
    match /majlis_rooms/{room}/threads/{thread} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 140
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.createdAt is timestamp
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /majlis_rooms/{room}/threads/{thread}/posts/{post} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.createdAt is timestamp
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
