   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Grounding pulls the mind out of the future and into the room: name five things you can see, four you can feel, three you can hear, two you can smell, one you can taste."
   },
   "ageBand": ["adult"],
   "tags": ["anxiety", "grounding", "coping"],
