  {
   "id": "anxiety_panic.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "A panic attack feels like danger, but it is the body's alarm going off with no fire. It rises, peaks, and passes, usually within minutes. Fighting it feeds it; riding it out lets it fall."
   },
   "ageBand": ["adult"],
   "tags": ["anxiety", "panic", "normal"],
   "triggers": ["panic", "attack", "dying"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 10.1", "note": "Anxiety and panic: slow breathing, grounding and gradual return to avoided things are standard first steps; persistent or disabling anxiety should go to a clinician. General teaching; no source opened; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
   "needsClinicianReview": true,
   "needsNativeClinicianReview": false,
   "reviewedBy": null,
   "reviewedOn": null,
   "status": "draft"
  },
  {
   "id": "anxiety_panic.explain.002",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Slow breathing helps because a long out-breath tells the body it is safe. In through the nose for a count of four, out through the mouth for a count of six, for a few minutes."
   },
   "ageBand": ["adult"],
   "tags": ["anxiety", "breathing", "coping"],
   "triggers": ["breathe", "breathing", "calm"],
   "doNotSay": [],
   "sources": [
