  {
   "id": "relapse_and_slips.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Slips are common on the road away from alcohol, drugs, gambling and other habits. They don't mean treatment has failed. They show what to plan for next time."
   },
   "ageBand": ["adult"],
   "tags": ["relapse", "normal", "learning"],
   "triggers": ["i failed", "back to square one", "i ruined it"],
   "doNotSay": [],
