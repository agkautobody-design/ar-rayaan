   "id": "anger.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Anger has a ladder: first the body tightens, then thoughts sharpen, then words and actions follow. The earlier you step off, the easier it is."
   },
   "ageBand": ["adult"],
   "tags": ["anger", "normal"],
   "triggers": ["explode", "snap", "fast"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 10.1", "note": "Anger: noticing early signs, pausing, slow breathing and leaving the situation briefly reduce harm; anger that leads to violence or fear at home needs professional support. General teaching; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
   "needsClinicianReview": true,
   "needsNativeClinicianReview": false,
