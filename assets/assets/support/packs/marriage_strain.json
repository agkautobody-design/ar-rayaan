   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Feeling unloved often grows in silence, not in cruelty. The longer it goes unnamed, the louder it feels. Saying it, gently and specifically, is how it starts to shrink."
   },
   "ageBand": ["adult"],
   "tags": ["distress", "unloved"],
