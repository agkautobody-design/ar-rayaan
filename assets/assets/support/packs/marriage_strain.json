  {
   "id": "marriage_strain.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Most couples in trouble are not having many different fights; they are having one fight, on repeat, in different costumes. Naming the loop is the first step out of it."
   },
   "ageBand": ["adult"],
   "tags": ["distress", "cycle"],
   "triggers": ["argue", "arguing", "fight", "loop", "same"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 10.1", "note": "Emotional support: listening, validation and small steps help; persistent or disabling distress should go to a clinician. General teaching; no source opened; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
   "needsClinicianReview": true,
   "needsNativeClinicianReview": false,
   "reviewedBy": null,
   "reviewedOn": null,
   "status": "draft"
  },
  {
   "id": "marriage_strain.explain.002",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Repair matters more than never fighting. Couples who recover after conflict — a soft word, a cup of tea, a small joke — do better than couples who never disagree."
   },
   "ageBand": ["adult"],
   "tags": ["distress", "repair"],
   "triggers": ["fight", "argue", "repair", "after"],
