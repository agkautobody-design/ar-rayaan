   "id": "sexual_violence.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Sex without your clear agreement is assault, including in marriage, and including when you froze or didn't fight back. Freezing is a common response."
   },
   "ageBand": ["adult"],
   "tags": ["sexual-violence", "definition", "consent", "marital"],
   "triggers": ["my husband forced", "in marriage", "i froze", "i did not say no"],
