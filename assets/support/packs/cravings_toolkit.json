   "status": "draft"
  },
  {
   "id": "cravings_toolkit.explain.004",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Slow breathing can calm the body: in gently through the nose, then out for longer than you breathed in. Try it for a minute or two."
   },
   "ageBand": ["adult"],
   "tags": ["cravings", "breathing"],
   "triggers": ["panic", "heart racing", "calm down"],
   "doNotSay": [],
