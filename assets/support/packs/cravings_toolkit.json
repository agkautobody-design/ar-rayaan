  {
   "id": "cravings_toolkit.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Urges rise, peak and fall, often within a short time, even if it feels endless. Waiting and doing something else gives it room to pass."
   },
   "ageBand": ["adult"],
   "tags": ["cravings", "urge-surfing"],
   "triggers": ["it won't go away", "cannot stand it"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 3.8", "note": "Urge surfing, delay, distraction and reaching out are standard relapse-prevention skills; no source opened; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
   "needsClinicianReview": true,
   "needsNativeClinicianReview": false,
   "reviewedBy": null,
   "reviewedOn": null,
   "status": "draft"
  },
  {
   "id": "cravings_toolkit.explain.002",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Hunger, tiredness, loneliness and stress make urges louder. Eating something, drinking water and resting a few minutes can turn the volume down."
   },
   "ageBand": ["adult"],
   "tags": ["cravings", "halt"],
   "triggers": ["hungry", "tired", "lonely", "stressed"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 3.8", "note": "Urge surfing, delay, distraction and reaching out are standard relapse-prevention skills; no source opened; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
   "needsClinicianReview": true,
   "needsNativeClinicianReview": false,
   "reviewedBy": null,
   "reviewedOn": null,
   "status": "draft"
  },
  {
   "id": "cravings_toolkit.explain.003",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Changing your place helps. Leave the room, go outside or go where other people are. The urge often weakens with distance from the cue."
   },
   "ageBand": ["adult"],
   "tags": ["cravings", "environment"],
   "triggers": ["at home alone", "in the car"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 3.8", "note": "Urge surfing, delay, distraction and reaching out are standard relapse-prevention skills; no source opened; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
