   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Abuse often gets worse over time, and leaving can be the most dangerous time. That's why planning with a trained advisor matters. You decide what's right for you."
   },
   "ageBand": ["adult"],
