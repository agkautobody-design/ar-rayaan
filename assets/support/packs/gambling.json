   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Gambling problems are common, and people do recover. Support usually combines talking help, practical steps with money, and often peers who have been there."
   },
   "ageBand": ["adult"],
   "tags": ["gambling", "hope", "treatment"],
   "triggers": ["can i stop", "is there hope"],
