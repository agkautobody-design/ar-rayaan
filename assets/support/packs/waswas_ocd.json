   "id": "waswas_ocd.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Intrusive thoughts are common and do not reflect your will. What matters is that you hate them, and that is not how a person who wants them feels."
   },
   "ageBand": ["adult"],
   "tags": ["waswas", "normal"],
   "triggers": ["blasphem", "evil", "thoughts", "intrusive"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 10.1", "note": "Intrusive doubts and compulsions: reassurance-seeking and rechecking keep them going; treatment with a clinician (exposure and response prevention) is effective. General teaching; clinician to confirm."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
