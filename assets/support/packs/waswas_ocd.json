   "id": "waswas_ocd.explain.002",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Repeating, rechecking and reassurance bring a short relief and teach the mind to ask again. Gently resisting the urge, a little more each day, is how the loop weakens."
   },
   "ageBand": ["adult"],
   "tags": ["waswas", "normal"],
