   "id": "elder_abuse.explain.003",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Carers under heavy strain sometimes lose patience or neglect things without meaning to. Respite and support can help both of you. Asking for help early is better than waiting for a crisis."
   },
   "ageBand": ["adult"],
   "tags": ["elder-abuse", "carer-strain"],
