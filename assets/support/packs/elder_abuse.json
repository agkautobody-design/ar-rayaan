   "id": "elder_abuse.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Abuse of older people includes hitting, neglect, taking their money, controlling them, and frightening or humiliating them. Most of the time it's done by someone the person knows."
   },
   "ageBand": ["adult"],
