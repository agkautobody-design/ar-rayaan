   "id": "shame_despair.explain.002",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Shame tells you that you are the problem. Guilt says you did something wrong. They are different, and shame is not a fair judge of who you are."
   },
   "ageBand": ["adult"],
   "tags": ["shame", "despair", "shame-guilt"],
