  {
   "id": "family_of_struggling.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "You did not cause their struggle, you cannot control it, and you cannot cure it. You can look after yourself and respond to them in a caring way."
   },
   "ageBand": ["adult"],
   "tags": ["family-of", "three-cs"],
   "triggers": ["is it my fault", "did i cause it"],
   "doNotSay": [],
   "sources": [
    {"type": "guideline", "title": "NIAAA Core Resource on Alcohol: alcohol use disorder, risk, diagnosis and recovery", "url": "https://www.niaaa.nih.gov/health-professionals-communities/core-resource-on-alcohol/alcohol-use-disorder-risk-diagnosis-recovery", "section": "RES_H1 2.1", "retrievedOn": "2026-10-27"}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
