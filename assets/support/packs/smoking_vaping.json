  {
   "id": "smoking_vaping.explain.001",
   "kind": "explain",
   "stage": ["explore"],
   "text": {
    "en": "Quitting is easier with support. Talking help from a quitline, together with medicine that a pharmacist or doctor can advise on, helps many people quit. You can also do it with only one of these."
   },
   "ageBand": ["adult"],
   "tags": ["smoking", "treatment", "support"],
   "triggers": ["best way to quit", "how do i quit"],
   "doNotSay": [],
   "sources": [
    {"type": "background", "section": "RES_H1 3.11", "note": "Behavioural support plus pharmacotherapy roughly doubles quit rates and quitlines work: brief gives this as general knowledge, no source opened; clinician to supply the source."}
   ],
   "evidenceLevel": "C",
   "risk": "low",
   "askPermission": true,
   "needsScholarReview": false,
   "needsClinicianReview": true,
   "needsNativeClinicianReview": false,
   "reviewedBy": null,
   "reviewedOn": null,
   "status": "draft"
  },
  {
