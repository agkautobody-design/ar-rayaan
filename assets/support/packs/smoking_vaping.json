   },
   "ageBand": ["adult"],
   "tags": ["smoking", "nrt", "pharmacist"],
   "triggers": ["patches", "gum", "nicotine replacement"],
   "doNotSay": ["Never doses or schedules; hand over to the pharmacist."],
